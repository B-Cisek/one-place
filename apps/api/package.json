{
  "name": "@one-place/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "db:auth-schema": "auth generate --config auth.config.ts --output src/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "exports": {
    ".": "./src/app.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@one-place/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
